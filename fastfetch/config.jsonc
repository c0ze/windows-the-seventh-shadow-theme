// The Seventh Shadow: fastfetch on Windows.
// Logo: the band's crest (seventh-shadow-crest.txt beside this file).
// The first row shows the motherboard: custom-built PCs leave the "host" model blank.
// Key colors are ANSI names so they follow the terminal scheme:
//   cyan = the veins, yellow = gold, magenta = plum.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "__CREST__",
    "color": {
      "1": "cyan"
    },
    "padding": {
      "top": 2,
      "right": 6,
      "left": 2
    }
  },
  "display": {
    "disableLinewrap": true
  },
  "modules": [
    "break",
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌───────────────The Machine · Hardware───────────────┐"
    },
    {
      "type": "board",
      "key": " PC",
      "keyColor": "cyan"
    },
    {
      "type": "cpu",
      "key": "│ ├",
      "showPeCoreCount": true,
      "keyColor": "cyan"
    },
    {
      "type": "gpu",
      "key": "│ ├",
      "detectionMethod": "pci",
      "format": "{name}",
      "keyColor": "cyan"
    },
    {
      "type": "display",
      "key": "│ ├󱄄",
      "keyColor": "cyan"
    },
    {
      "type": "disk",
      "key": "│ ├󰋊",
      "keyColor": "cyan"
    },
    {
      "type": "memory",
      "key": "│ ├",
      "keyColor": "cyan"
    },
    {
      "type": "swap",
      "key": "└ └󰓡 ",
      "keyColor": "cyan"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────The Ghost · Software────────────────┐"
    },
    {
      "type": "os",
      "key": " OS",
      "keyColor": "yellow"
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "yellow"
    },
    {
      "type": "wm",
      "key": "│ ├",
      "keyColor": "yellow"
    },
    {
      "type": "de",
      "key": " DE",
      "keyColor": "yellow"
    },
    {
      "type": "terminal",
      "key": "│ ├",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖",
      "keyColor": "yellow"
    },
    {
      "type": "wmtheme",
      "key": "│ ├󰉼",
      "keyColor": "yellow"
    },
    {
      "type": "theme",
      "key": "│ ├󰸌",
      "keyColor": "yellow"
    },
    {
      "type": "terminalfont",
      "key": "└ └",
      "keyColor": "yellow"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────The Shadow · Shell / Uptime─────────────┐"
    },
    {
      "type": "shell",
      "key": "󱦟 Shell ",
      "keyColor": "magenta"
    },
    {
      "type": "uptime",
      "key": "󱫐 Uptime",
      "keyColor": "magenta"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m                 Alienation By Design"
    },
    {
      "type": "custom",
      "format": "\u001b[36m                the7th-shadow.arda.tr"
    },
    "break"
  ]
}
